{
  "manifest_version": 3,
  "name": "书签管理器",
  "version": "1.2.0",
  "description": "自动列出收藏的网址，支持添加、修改、删除、文件夹管理以及 JSON / HTML 书签导入导出。",
  "permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "书签管理器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}